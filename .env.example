# Copy to .env. Lines without a default must be filled in before the first start.

# --- Required -----------------------------------------------------------------
# openssl rand -base64 24
POSTGRES_PASSWORD=
# openssl rand -base64 48
JWT_SECRET=
# First administrator, created on first start. Password: 12+ characters.
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# --- Where the app lives ------------------------------------------------------
HTTP_PORT=8080
PUBLIC_URL=http://localhost:8080
# Set to true as soon as PUBLIC_URL uses https.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
# Decides when a study day starts for streaks and reminders.
APP_TIMEZONE=UTC

# Turn on once HTTPS works, e.g. max-age=31536000. Only sent on HTTPS requests.
HSTS_HEADER_VALUE=
# Plain-HTTP image hosts the Content-Security-Policy should allow, e.g. http://minio.local:9000
CSP_EXTRA_MEDIA_SOURCES=

# --- Optional: developer role (site settings, gallery admin) ------------------
DEFAULT_DEV_EMAIL=
DEFAULT_DEV_PASSWORD=

# --- Optional: email (confirmation codes, reminders, contact replies) ---------
# Port 465 uses TLS from the start; STARTTLS is required on 25, 587, 2525 and with a username.
# What is set here can't be changed in the settings, nor can the host or username while SMTP_PASSWORD is set here.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender address. Falls back to SMTP_USERNAME; email stays off if neither is an address.
SMTP_FROM=
EMAIL_SENDER_NAME=ExamPrep

# --- Optional: image storage, S3 or anything compatible (MinIO, R2) -----------
# R2: docs/configuration.md#cloudflare-r2
AWS_S3_ACCESS_KEY=
AWS_S3_SECRET_KEY=
AWS_S3_REGION=
AWS_S3_BUCKET=
# The same goes for the endpoint and AWS_S3_SECRET_KEY: without either here, changing it in the settings clears the stored key.
AWS_S3_ENDPOINT=
# Address browsers use for images, when different (e.g. MinIO inside Compose).
AWS_S3_PUBLIC_ENDPOINT=

# --- Optional: upload limits per user (0 turns a limit off) ---------------------
MAX_UPLOAD_MB=10
MAX_UPLOADS_PER_DAY=100

# --- Optional: other limits (0 turns the first one off) ---------------------------
MAX_STUDY_AREAS_PER_USER=100
MAX_IMPORT_QUESTIONS=500
CONFIRMATION_CODE_SENDS_PER_HOUR=5
# Requests per minute per client: to one route, and overall. Raise them if many people share one address.
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_TOTAL=600

# --- Optional: social login ---------------------------------------------------
OAUTH_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_ENABLED=false
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# --- Optional: AI question generation -----------------------------------------
# Encrypts provider API keys, and S3 and SMTP secrets entered in the settings, at rest. openssl rand -base64 32
AI_SETTINGS_ENCRYPTION_KEY=

# --- Development only (docker-compose.dev.yml) --------------------------------
PGADMIN_DEFAULT_PASSWORD=
VITE_API_BASE_URL=http://localhost:8080/api
